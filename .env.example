# Application
ARB_ENV=development
ARB_LOG_LEVEL=INFO
ARB_API_HOST=0.0.0.0
ARB_API_PORT=8000
ARB_CORS_ORIGINS=http://localhost:5173
ARB_LIVE_TRADING_ENABLED=false
# Phase 15 control-plane authentication.
# Use a high-entropy secret and never expose it to the Rust engine or source control.
ARB_CONTROL_API_TOKEN=
ARB_CONTROL_STATE_FILE=data/control/trading_state.json

# Phase 10 execution credentials. Keep them out of source control.
# Phase 2 public market data does not use API credentials.
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Phase 2 public market data
BYBIT_MARKET_CATEGORY=spot
BYBIT_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
BYBIT_ORDERBOOK_DEPTH=50
BYBIT_SUBSCRIBE_TRADES=true
BYBIT_SUBSCRIBE_TICKERS=true
BYBIT_HEARTBEAT_SECONDS=20
BYBIT_STALE_AFTER_SECONDS=10
BYBIT_RECONNECT_MIN_MS=500
BYBIT_RECONNECT_MAX_SECONDS=30

# Phase 5 scanner
ARB_TRIANGLE_CONFIG=shared/config/triangles.json
ARB_SCANNER_CONFIG=shared/config/scanner.json
ARB_PROFITABILITY_CONFIG=shared/config/profitability.json

# Phase 7 PostgreSQL opportunity ledger
ARB_DATABASE_URL=postgresql+psycopg://arbitrage:arbitrage@localhost:5432/arbitrage
ARB_OPPORTUNITY_MIN_NET_BPS=0
ARB_OPPORTUNITY_MAX_GAP_MS=2000
ARB_OPPORTUNITY_BATCH_SIZE=250


# Phase 9 risk gate
ARB_RISK_CONFIG=shared/config/risk.json

# Phase 10 private execution engine
# Testnet is the safe default. Mainnet additionally requires ARB_LIVE_TRADING_ENABLED=true.
BYBIT_EXECUTION_TESTNET=true
BYBIT_EXECUTION_RECV_WINDOW_MS=5000
BYBIT_EXECUTION_REQUEST_TIMEOUT_MS=3000
BYBIT_EXECUTION_MAX_RETRIES=2
BYBIT_EXECUTION_RETRY_BASE_MS=100
BYBIT_EXECUTION_POLL_INTERVAL_MS=50
BYBIT_EXECUTION_ORDER_TIMEOUT_MS=3000
BYBIT_EXECUTION_CANCEL_TIMEOUT_MS=2000
BYBIT_EXECUTION_FILL_CONFIRM_TIMEOUT_MS=2000
BYBIT_EXECUTION_MAX_ORDER_NOTIONAL=5
BYBIT_EXECUTION_MAX_EXECUTION_PAGES=20
BYBIT_EXECUTION_ACCOUNT_TYPE=UNIFIED
BYBIT_EXECUTION_CANCEL_ON_TIMEOUT=true

# Phase 11 three-leg coordinator
ARB_COORDINATOR_CONFIG=shared/config/coordinator.json

# Phase 12 live shadow mode
# Uses mainnet public market data and authenticated GET-only account reads.
# Use separate mainnet credentials with no trading permissions.
ARB_SHADOW_CONFIG=shared/config/shadow.json
BYBIT_SHADOW_API_KEY=
BYBIT_SHADOW_API_SECRET=
BYBIT_SHADOW_RECV_WINDOW_MS=5000
BYBIT_SHADOW_REQUEST_TIMEOUT_MS=3000
ARB_SHADOW_BATCH_SIZE=250


# Phase 13 micro-live canary
# Read-only candidate generation. It refuses to run while live trading is enabled.
ARB_MICRO_CANARY_CONFIG=shared/config/micro_canary.json
ARB_MICRO_CANARY_SHADOW_READY=false
ARB_MICRO_LIVE_BATCH_SIZE=100
