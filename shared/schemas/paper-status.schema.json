{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["account_id", "mode", "simulated", "state", "authorized", "blocked", "runtime_online", "active_cycles", "pending_orders", "balances"],
  "properties": {
    "clock": {"enum":["wall","virtual"]},
    "account_id": {"type":"string"}, "mode": {"const":"paper"}, "simulated": {"const":true},
    "state": {"enum":["recovering","blocked","offline","executing","running","stopped"]},
    "authorized": {"type":"boolean"}, "blocked": {"type":"boolean"}, "runtime_online": {"type":"boolean"},
    "active_cycles": {"type":"integer","minimum":0}, "pending_orders": {"type":"integer","minimum":0},
    "balances": {"type":"array","items":{"type":"object","required":["asset","available","reserved"],
      "properties":{"asset":{"type":"string"},"available":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)?$"},"reserved":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)?$"}}}}
  }
}
